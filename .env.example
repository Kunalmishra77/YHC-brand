# =============================================================================
# Your Hair Company — environment variables
# Copy to .env.local for development. Never commit real values.
# Validated at boot by src/lib/env.ts. "phase NN" = first phase that needs it.
# =============================================================================

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=local                         # local | staging | production
CRON_SECRET=                          # phase 01 · random 32+ chars; bearer for /api/cron/*
LINK_SIGNING_SECRET=                  # phase 04 · random 32 bytes (base64) for signed /l/ links
ENCRYPTION_KEY=                       # phase 05 · 32 bytes base64 (AES-256-GCM) for OAuth tokens

# --- Supabase --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # from `supabase start` output
SUPABASE_SERVICE_ROLE_KEY=            # server only
SUPABASE_SEND_SMS_HOOK_SECRET=        # phase 03 · Auth > Hooks > Send SMS (v1,whsec_...)

# --- Razorpay (phase 03) -------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=          # rzp_test_... in dev/staging
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Messaging (phase 03 log provider; phase 08 real) ----------------------------
WHATSAPP_PROVIDER=log                 # log | generic-http | meta-cloud
WHATSAPP_HTTP_BASE_URL=               # generic-http: existing BSP API
WHATSAPP_HTTP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=              # shared secret for BSP → /api/webhooks/whatsapp
WHATSAPP_PHONE_NUMBER_ID=             # meta-cloud
WHATSAPP_ACCESS_TOKEN=                # meta-cloud (system user token)
WHATSAPP_VERIFY_TOKEN=                # meta-cloud webhook verify token
META_APP_SECRET=                      # X-Hub-Signature-256 verification (WhatsApp + Lead Ads)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_TXN_TEMPLATE_IDS={}             # JSON map: template key -> DLT template id
MSG91_WEBHOOK_TOKEN=                  # verifies delivery-report callbacks
RESEND_API_KEY=
EMAIL_FROM="Your Hair Company <care@yourhaircompany.com>"
RESEND_WEBHOOK_SECRET=

# --- Rate limiting (phase 03) ----------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Video & calendar (phase 05) -------------------------------------------------
VIDEO_PROVIDER=livekit                # livekit | meet
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/doctor/settings/calendar/callback

# --- CRM / marketing (phase 07, 11) ---------------------------------------------
META_LEADS_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=               # leads_retrieval
META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_TEST_EVENT_CODE=            # staging only
NEXT_PUBLIC_GA_ID=

# --- Shipping (phase 09) ---------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=

# --- Observability (phase 00) ----------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                    # CI source maps only
LOG_LEVEL=info
