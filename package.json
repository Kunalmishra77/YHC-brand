{
  "name": "yhc-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --dir tests/integration --passWithNoTests",
    "db:start": "node -e \"console.log('No local Docker (ADR-22): dev uses the hosted yhc-dev project. Run pnpm db:link once, then pnpm db:reset.')\"",
    "db:link": "node scripts/supabase.mjs link --project-ref {ref}",
    "db:reset": "node scripts/supabase.mjs db reset --linked",
    "db:push": "node scripts/supabase.mjs db push --linked",
    "db:config": "node scripts/supabase.mjs config push --project-ref {ref}",
    "db:types": "node scripts/supabase.mjs gen types typescript --linked --schema public --write src/lib/database.types.ts",
    "seed:dev": "node -e \"console.log('seed:dev arrives in Phase 01 (scripts/seed-dev.ts)')\"",
    "jobs:tick": "node -e \"console.log('jobs:tick arrives in Phase 01')\"",
    "lint:claims": "node -e \"console.log('lint:claims placeholder — real check in Phase 12')\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "16.3.8",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "msw": "^3.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.11.0"
}
